# ==============================================================================
# SERVICIOS AUTOMATION & BOOKING MONITOR CONFIGURATION (.env)
# ==============================================================================

# Admin Credentials (Required for automated login)
SERVICIOS_ADMIN_EMAIL=admin@admin.com
SERVICIOS_ADMIN_PASSWORD=EJWH74F4NCH7743aatf@@

# Target Production URLs
SERVICIOS_LOGIN_URL=https://admin.coyoacan.io/auth/login
SERVICIOS_BOOKINGS_URL=https://admin.coyoacan.io/bookings?category=booking

# Exact Production Booking API Endpoint (Targeting NEW bookings)
SERVICIOS_BOOKING_API_URL=https://backend.coyoacan.io/api/v1/admin/bookings/getAll-bookingdotcomdata?search=&page=1&limit=150&query=new&city_name=Madrid&fromDate=&toDate=

# Status Filter (Strictly tracks and alerts for 'NEW' status bookings)
SERVICIOS_FILTER_STATUS=NEW

# Optional: Bearer Token or Custom Auth Header (if required in addition to browser cookies)
SERVICIOS_BOOKING_AUTH_TOKEN=

# Monitoring Polling Interval in seconds (Default: 30)
SERVICIOS_BOOKING_POLL_INTERVAL=30

# Selenium Chrome Execution Options
SERVICIOS_HEADLESS=false

# Future UI Verification toggle (Default: false, strictly read-only)
SERVICIOS_VERIFY_UI=false

# Output directory for forensic evidence logs
SERVICIOS_OUTPUT_DIR=monitoring/output
